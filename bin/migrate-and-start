#!/bin/bash -e

# Production start command for hosts without a release / pre-deploy step (Render's free
# plan). Applies pending migrations, provisions the HR account, then starts the server.
#
# Use it ONLY with a single instance: with several replicas each one would try to migrate.
# On a paid plan, use a pre-deploy command (bin/rails db:migrate) and the image's default
# command instead.

./bin/rails db:migrate
./bin/rails users:provision_hr
exec ./bin/rails server
